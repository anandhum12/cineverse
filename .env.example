# ── Core ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
# Used to sign QR ticket tokens (falls back to NEXTAUTH_SECRET)
TICKET_SIGNING_SECRET=

# ── Google sign-in (optional) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay (optional – sandbox gateway is used when unset) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The built-in sandbox gateway is disabled when NODE_ENV=production unless this is "true"
ALLOW_SANDBOX_PAYMENTS=

# ── Redis seat locks (optional – in-memory locks used when unset) ──
REDIS_URL=

# ── Tunables ─────────────────────────────────────────
SEAT_HOLD_SECONDS=420
